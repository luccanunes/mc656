generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nome         String
  email        String     @unique
  senha        String
  imagem       String?
  avaliacoes   Avaliacao[]
  deficiencias String?    // Armazenado como string delimitada
  createdAt    DateTime   @default(now())
  locais       Local[]    // Relação com locais criados
}

