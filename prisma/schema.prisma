model Avaliacao {
  id        Int     @id @default(autoincrement())
  nota      Int
  comentario String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int
  local     Local   @relation(fields: [localId], references: [id])
  localId   Int
}